{
  "baseUrl": "http://127.0.0.1:3001",
  "outputDir": ".studio/qa",
  "contractPath": ".studio/design-contract.yaml",
  "routes": [
    { "name": "home", "path": "/" }
  ],
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1100 },
    { "name": "mobile", "width": 390, "height": 844 }
  ],
  "flows": [
    {
      "name": "initial",
      "route": "/",
      "steps": [
        {
          "type": "expectVisible",
          "selector": "[data-studio-component=\"identity-hero\"]"
        },
        {
          "type": "expectText",
          "selector": "[data-studio-component=\"identity-hero\"]",
          "value": "Farhoud Talebi"
        },
        {
          "type": "expectText",
          "selector": "[data-studio-component=\"identity-hero\"]",
          "value": "Software Engineer"
        },
        {
          "type": "expectText",
          "selector": "[data-studio-component=\"identity-hero\"]",
          "value": "I build innovative software solutions"
        },
        {
          "type": "expectVisible",
          "selector": "[data-studio-component=\"identity-hero\"] [data-studio-component=\"resume-link\"]"
        },
        {
          "type": "expectText",
          "selector": "[data-studio-component=\"identity-hero\"] [data-studio-component=\"resume-link\"]",
          "value": "Résumé"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"primary-action\"]"
        }
      ]
    },
    {
      "name": "project-catalog-static",
      "route": "/",
      "steps": [
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-published-product\"]"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-selected-work\"]"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-archive\"]"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(1) h4",
          "value": "DeenPath"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(2) h4",
          "value": "StockScanner"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(3) h4",
          "value": "Remote Admin Toolkit"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(4):last-child h4",
          "value": "Imposter Hunt"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(1) img[src*=\"deenpath-store.webp\"]"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(2) img[src*=\"stockscanner-cover.webp\"]"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(3) img[src*=\"rat-cover.webp\"]"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"project-selected-work\"] > ul > li:nth-child(4):last-child img[src*=\"imposter-hunt.webp\"]"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(1)",
          "value": "AndroidQuizApp"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(2)",
          "value": "Animal Adoption Center"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(3)",
          "value": "ChatServer"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(4)",
          "value": "FlickrViewer"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(5)",
          "value": "MazeSolver"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(6)",
          "value": "Mechanic Shop"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(7)",
          "value": "Mortgage Scenario Comparisons"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(8)",
          "value": "PersonalWebsite2025"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(9)",
          "value": "Purchase Calculator"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(10)",
          "value": "Recipe Adventure"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(11)",
          "value": "Rental Cash Dam"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(12)",
          "value": "Rental Property Calculator"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"project-archive\"] > ol > li:nth-child(13):last-child",
          "value": "SwiftProjectileCalculationApp"
        }
      ]
    },
    {
      "name": "mobile-navigation",
      "route": "/",
      "steps": [
        {
          "type": "click",
          "selector": "[data-qa=\"mobile-menu-toggle\"]:visible, [data-studio-component=\"site-navigation\"] > .container-custom > div > ul a[href=\"#projects\"]:visible"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"mobile-menu-toggle\"][aria-expanded=\"true\"]:visible, [data-studio-component=\"site-navigation\"] > .container-custom > div > ul a[href=\"#projects\"]:visible"
        },
        {
          "type": "press",
          "value": "Tab"
        },
        {
          "type": "expectVisible",
          "selector": "#mobile-navigation-drawer a[href=\"#projects\"]:visible, [data-studio-component=\"site-navigation\"] > .container-custom > div > ul a[href=\"#projects\"]:visible"
        },
        {
          "type": "click",
          "selector": "#mobile-navigation-drawer a[href=\"#projects\"]:visible, [data-studio-component=\"site-navigation\"] > .container-custom > div > ul a[href=\"#projects\"]:visible"
        },
        {
          "type": "expectVisible",
          "selector": "[data-studio-section=\"projects\"]"
        }
      ]
    },
    {
      "name": "contact-validation",
      "route": "/",
      "steps": [
        {
          "type": "click",
          "selector": "[data-qa=\"contact-form\"] button[type=\"submit\"]"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"contact-form\"]",
          "value": "Name is required"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"contact-form\"]",
          "value": "Email is required"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"contact-form\"]",
          "value": "Subject is required"
        },
        {
          "type": "expectText",
          "selector": "[data-qa=\"contact-form\"]",
          "value": "Message is required"
        }
      ]
    },
    {
      "name": "theme-dark",
      "route": "/",
      "steps": [
        {
          "type": "click",
          "selector": "[data-qa=\"theme-toggle\"]"
        },
        {
          "type": "expectVisible",
          "selector": "html.dark"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"theme-toggle\"][aria-label=\"Switch to light theme\"]"
        }
      ]
    },
    {
      "name": "signal-controls",
      "route": "/",
      "steps": [
        {
          "type": "click",
          "selector": "[data-qa=\"signal-controls-toggle\"]"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"signal-controls-toggle\"][aria-expanded=\"true\"]"
        },
        {
          "type": "expectVisible",
          "selector": "#particle-signal-controls-panel"
        },
        {
          "type": "click",
          "selector": "#particle-signal-controls-panel fieldset:first-of-type button:nth-of-type(2)"
        },
        {
          "type": "expectVisible",
          "selector": "#particle-signal-controls-panel fieldset:first-of-type button:nth-of-type(2)[aria-pressed=\"true\"]"
        },
        {
          "type": "click",
          "selector": "#particle-signal-controls-panel fieldset:last-of-type button:nth-child(2)"
        },
        {
          "type": "expectVisible",
          "selector": "#particle-signal-controls-panel fieldset:last-of-type button:nth-child(2)[aria-pressed=\"true\"]"
        },
        {
          "type": "press",
          "value": "Escape"
        },
        {
          "type": "waitFor",
          "selector": "#particle-signal-controls-panel",
          "state": "detached"
        },
        {
          "type": "expectVisible",
          "selector": "[data-qa=\"signal-controls-toggle\"][aria-expanded=\"false\"]"
        }
      ]
    }
  ],
  "timeoutMs": 15000,
  "qa": {
    "failOnConsoleError": true,
    "failOnPageError": true,
    "failOnHorizontalOverflow": true,
    "failOnSeriousA11y": true,
    "fullPageScreenshots": true
  }
}
